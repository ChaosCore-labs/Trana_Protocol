{
  "name": "protocol-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for the freight-delay Anchor program",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vitepress dev --host",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "bun scripts/check-render.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "jsdom": "^30.1.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.1",
    "vue": "^3.5.41"
  }
}
